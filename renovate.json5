{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on Monday"],
  "commitMessagePrefix": "chore(deps): ",
  "labels": ["dependencies", "ci", "renovate"],
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "pip-audit pin in .github/workflows/vulncheck.yml",
      "fileMatch": ["^\\.github/workflows/vulncheck\\.yml$"],
      "matchStrings": [
        "pip-audit==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pip-audit"
    }
  ],
  "dockerfile": {
    "enabled": true
  },
  "docker-compose": {
    "enabled": true
  }
}
